# Copie para .env e ajuste. Nunca versione o .env.
NODE_ENV=development
PORT=3000
APP_TIMEZONE=America/Sao_Paulo
# Endereço do frontend (links enviados por e-mail)
APP_PUBLIC_URL=http://localhost:3001

# Banco (docker compose expõe o Postgres/PostGIS na porta 5434)
DATABASE_URL="postgresql://reciclabairro:reciclabairro@localhost:5434/reciclabairro?schema=public"

# Autenticação
JWT_ACCESS_SECRET=troque-este-segredo-em-producao-0001
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=30
# Mesmo valor do .env do frontend: permite limitar requisições por usuário, e não pelo IP do frontend
BFF_SHARED_SECRET=segredo-local-entre-bff-e-api-0001

# CORS: lista separada por vírgula, ou * em desenvolvimento
CORS_ORIGINS=*

# E-mail (Mailpit local). Sem SMTP_HOST os e-mails são apenas registrados no log.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ReciclaBairro <nao-responda@reciclabairro.local>"

# Push (Expo). Desligado por padrão.
PUSH_ENABLED=false

# Regras de negócio
LATE_TRIAGE_HOURS=48

# Senha das contas de demonstração criadas pelo seed
SEED_PASSWORD=Recicla@123
